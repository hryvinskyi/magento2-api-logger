<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::system">
                    <resource id="Hryvinskyi_ActivityLog::activity_log">
                        <resource id="Hryvinskyi_ApiLogger::api_logger" title="REST API Logs" translate="title" sortOrder="40">
                            <resource id="Hryvinskyi_ApiLogger::logs" title="View Logs" translate="title" sortOrder="10"/>
                            <resource id="Hryvinskyi_ApiLogger::replay" title="Replay Requests" translate="title" sortOrder="15"/>
                            <resource id="Hryvinskyi_ApiLogger::delete" title="Delete Logs" translate="title" sortOrder="20"/>
                        </resource>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Hryvinskyi_ApiLogger::config_api_logger" title="REST API Logging Settings" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
