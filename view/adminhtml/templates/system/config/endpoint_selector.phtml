declare(strict_types=1);

use Hryvinskyi\ApiLogger\Block\Adminhtml\System\Config\EndpointSelector;
use Magento\Framework\Escaper;

/**
 * @var EndpointSelector $block
 * @var Escaper $escaper
 */

$elementId = $block->getElementId();
$selected = $block->getSelectedEndpoints();
?>
<div class="endpoint-selector-container"
     data-mage-init='<?= $escaper->escapeHtmlAttr($block->getScriptConfig()) ?>'>
    <div class="endpoint-selector-header">
        <input type="search" class="endpoint-selector-search ignore-validate" data-role="search"
               placeholder="<?= $escaper->escapeHtmlAttr(__('Search endpoints')) ?>"
               aria-label="<?= $escaper->escapeHtmlAttr(__('Search endpoints')) ?>">
        <div class="endpoint-selector-actions">
            <button type="button" class="endpoint-selector-btn ignore-validate" data-role="select-all">
                <?= $escaper->escapeHtml(__('Select All')) ?>
            </button>
            <button type="button" class="endpoint-selector-btn ignore-validate" data-role="select-none">
                <?= $escaper->escapeHtml(__('Deselect All')) ?>
            </button>
            <button type="button" class="endpoint-selector-btn ignore-validate" data-role="expand-all">
                <?= $escaper->escapeHtml(__('Expand All')) ?>
            </button>
            <button type="button" class="endpoint-selector-btn ignore-validate" data-role="collapse-all">
                <?= $escaper->escapeHtml(__('Collapse All')) ?>
            </button>
        </div>
    </div>

    <div class="endpoint-selector-body">
        <?php foreach ($block->getGroupedEndpoints() as $group => $endpoints): ?>
            <?php
            $values = array_map(
                static fn (array $endpoint): string => $endpoint['method'] . '|' . $endpoint['value'],
                $endpoints
            );
            $hasSelected = array_intersect($values, $selected) !== [];
            $groupToggleTitle = __('Select or deselect every endpoint of %1', $group);
            ?>
            <div class="endpoint-group<?= $hasSelected ? '' : ' collapsed' ?>" data-role="group">
                <div class="endpoint-group-header" data-role="group-header">
                    <div class="endpoint-group-title">
                        <input type="checkbox" class="group-select-all ignore-validate" data-role="group-toggle"
                               title="<?= $escaper->escapeHtmlAttr($groupToggleTitle) ?>">
                        <span class="endpoint-group-toggle" aria-hidden="true">▼</span>
                        <?= $escaper->escapeHtml($group) ?>
                    </div>
                    <span class="endpoint-group-count">
                        <span data-role="group-count">0</span> / <?= count($endpoints) ?>
                    </span>
                </div>
                <div class="endpoint-group-content">
                    <?php foreach ($endpoints as $index => $endpoint): ?>
                        <?php
                        $value = $values[$index];
                        $checkboxId = $elementId . '-' . hash('sha256', $value);
                        $searchText = strtolower($value . ' ' . $endpoint['label']);
                        ?>
                        <div class="endpoint-item" data-role="item"
                             data-search="<?= $escaper->escapeHtmlAttr($searchText) ?>">
                            <input type="checkbox" class="endpoint-checkbox ignore-validate" data-role="endpoint"
                                   id="<?= $escaper->escapeHtmlAttr($checkboxId) ?>"
                                   value="<?= $escaper->escapeHtmlAttr($value) ?>"
                                   <?= in_array($value, $selected, true) ? 'checked' : '' ?>>
                            <div class="endpoint-methods">
                                <span class="endpoint-method-badge
                                    <?= $escaper->escapeHtmlAttr(strtolower($endpoint['method'])) ?>">
                                    <?= $escaper->escapeHtml($endpoint['method']) ?>
                                </span>
                            </div>
                            <label for="<?= $escaper->escapeHtmlAttr($checkboxId) ?>">
                                <span class="endpoint-label-text"><?= $escaper->escapeHtml($endpoint['label']) ?></span>
                                <span class="endpoint-value"><?= $escaper->escapeHtml($endpoint['value']) ?></span>
                            </label>
                        </div>
                    <?php endforeach; ?>
                </div>
            </div>
        <?php endforeach; ?>
        <div class="no-results" data-role="no-results">
            <?= $escaper->escapeHtml(__('No endpoint matches the search.')) ?>
        </div>
    </div>

    <div class="endpoint-selector-footer">
        <div class="endpoint-selector-stats">
            <?= $escaper->escapeHtml(__('Selected')) ?>:
            <strong data-role="selected-count"><?= count($selected) ?></strong> /
            <span data-role="visible-count"><?= (int) $block->getTotalEndpointsCount() ?></span>
        </div>
    </div>

    <input type="hidden" data-role="value"
           id="<?= $escaper->escapeHtmlAttr($elementId) ?>"
           name="<?= $escaper->escapeHtmlAttr($block->getElementName()) ?>"
           value="<?= $escaper->escapeHtmlAttr(implode(',', $selected)) ?>">
</div>
