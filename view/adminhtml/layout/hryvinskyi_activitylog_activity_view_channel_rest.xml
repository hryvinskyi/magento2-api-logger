<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Hryvinskyi_ApiLogger::css/rest-panel.css"/>
    </head>
    <body>
        <referenceBlock name="activity.channel.fallback" remove="true"/>
        <referenceContainer name="activity.channel.panel">
            <block class="Magento\Framework\View\Element\Template" name="api.logger.rest.panel"
                   template="Hryvinskyi_ApiLogger::activity/rest-panel.phtml"
                   aclResource="Hryvinskyi_ApiLogger::logs">
                <arguments>
                    <argument name="panel" xsi:type="object">Hryvinskyi\ApiLogger\ViewModel\RestCallPanel</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
